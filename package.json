    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "arctic": "^3.2.0",
    "better-sqlite3": "^11.7.0",
